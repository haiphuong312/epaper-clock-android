<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="E-Paper Retro Clock &amp; Goals"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Tùy chỉnh sự kiện &amp; kế hoạch hiển thị trên màn hình"
            android:textColor="#888888"
            android:textSize="13sp" />

        <!-- 1. CÀI ĐẶT SỰ KIỆN ĐẾM NGƯỢC (THAY THẾ TẾT DƯƠNG LỊCH) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1E1E1E"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏳ SỰ KIỆN ĐẾM NGƯỢC (Ô GÓC PHẢI DƯỚI)"
                android:textColor="#EAEAE6"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tên sự kiện:"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/edtEventTitle"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="#2A2A2A"
                android:hint="Ví dụ: Tết Dương Lịch, Tết Nguyên Đán, Sinh nhật..."
                android:paddingHorizontal="10dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Ngày diễn ra (ngày/tháng/năm):"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/edtEventDate"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="#2A2A2A"
                android:hint="Ví dụ: 01/01/2027 hoặc 17/02/2027"
                android:paddingHorizontal="10dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- 2. CARD CÂU NÓI TRUYỀN CẢM HỨNG -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#1E1E1E"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💬 CHÂM NGÔN TRUYỀN CẢM HỨNG"
                android:textColor="#EAEAE6"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtQuote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#2A2A2A"
                android:hint="Nhập câu nói yêu thích..."
                android:minLines="2"
                android:padding="8dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:textSize="13sp" />

            <!-- Nút chọn nhanh -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnQuote1"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:text="Làm Chủ Bản Thân"
                        android:textColor="#E0E0E0"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnQuote2"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:text="Kỷ luật là tự do"
                        android:textColor="#E0E0E0"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnQuote3"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:text="Vạn dặm khởi từ một bước"
                        android:textColor="#E0E0E0"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnQuote4"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Tốt hơn hôm qua 1%"
                        android:textColor="#E0E0E0"
                        android:textSize="11sp" />

                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>

        <!-- 3. MỤC TIÊU KẾ HOẠCH (CÓ CHECKBOX CHỌN MỤC HIỂN THỊ) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#1E1E1E"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋 KẾ HOẠCH &amp; MỤC TIÊU (Tick chọn mục hiển thị)"
                android:textColor="#EAEAE6"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Hôm nay -->
            <CheckBox
                android:id="@+id/cbShowToday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:checked="true"
                android:text="Hiển thị mục tiêu Hôm nay"
                android:textColor="#4CAF50"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/edtTodayGoal"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="#2A2A2A"
                android:hint="Việc hôm nay..."
                android:paddingHorizontal="10dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:textSize="13sp" />

            <!-- Tuần này -->
            <CheckBox
                android:id="@+id/cbShowWeek"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:checked="true"
                android:text="Hiển thị mục tiêu Tuần này"
                android:textColor="#4CAF50"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/edtWeekGoal"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="#2A2A2A"
                android:hint="Kế hoạch tuần này..."
                android:paddingHorizontal="10dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:textSize="13sp" />

            <!-- Tháng này -->
            <CheckBox
                android:id="@+id/cbShowMonth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:checked="true"
                android:text="Hiển thị mục tiêu Tháng này"
                android:textColor="#4CAF50"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/edtMonthGoal"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="#2A2A2A"
                android:hint="Mục tiêu tháng này..."
                android:paddingHorizontal="10dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:textSize="13sp" />

            <!-- Năm nay -->
            <CheckBox
                android:id="@+id/cbShowYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:checked="true"
                android:text="Hiển thị mục tiêu Năm nay"
                android:textColor="#4CAF50"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/edtYearGoal"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="#2A2A2A"
                android:hint="Mục tiêu năm nay..."
                android:paddingHorizontal="10dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSaveGoals"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#4CAF50"
                android:text="💾 Lưu &amp; Cập nhật Ngay"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Hướng dẫn & Nút cài đặt -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#263238"
            android:padding="10dp"
            android:text="💡 Mẹo: Khi bấm nút bên dưới, màn hình Samsung hiện lên thì chọn 'Màn hình khóa' để chỉ áp dụng cho màn hình khóa nhé!"
            android:textColor="#80CBC4"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSetWallpaper"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#FFFFFF"
            android:text="⚙️ Cài làm Hình nền Màn hình khóa"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
